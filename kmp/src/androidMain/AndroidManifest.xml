<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application>
    <receiver android:name="org.tasks.location.LocationUpdateReceiver" android:exported="false"/>

    <activity
        android:name="org.tasks.auth.OAuthRedirectActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:taskAffinity=":oauth"
        android:autoRemoveFromRecents="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"/>

    <activity
        android:name="org.tasks.gtasks.GoogleAccountPickerActivity"
        android:exported="false"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
  </application>

</manifest>
